# ACA 2 - Computación en la Nube (Chatbot RAG) | Pilar Ventas
# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.

# Base vectorial del ACA 1 (Qdrant Cloud)
QDRANT_URL=https://xxxx.region.cloud.qdrant.io:6333
QDRANT_API_KEY=tu_api_key_de_qdrant
QDRANT_COLLECTION=ventas_ecommerce_rag
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LLM: basta con configurar UN proveedor
GOOGLE_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=openai/gpt-oss-120b
